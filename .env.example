# Développement local : copier en .env (ignoré par git), lu par l'API et par compose.yaml.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lameridienne
POSTGRES_USER=lameridienne
POSTGRES_PASSWORD=lameridienne

# Au moins 32 octets : openssl rand -base64 48
JWT_KEY=cle-de-developpement-au-moins-32-octets-xxxx
# Facultatifs (défauts dans appsettings.json) : JWT_ISSUER, JWT_AUDIENCE, SHOP_TIMEZONE, CORS_ORIGINS (séparées par des virgules)

# Comptes créés au premier démarrage (mot de passe : au moins 12 caractères).
SEED_USER_0_NAME=marie
SEED_USER_0_DISPLAY=Marie
SEED_USER_0_PASSWORD=mot-de-passe-marie
SEED_USER_1_NAME=paul
SEED_USER_1_DISPLAY=Paul
SEED_USER_1_PASSWORD=mot-de-passe-paul
SEED_USER_2_NAME=lea
SEED_USER_2_DISPLAY=Léa
SEED_USER_2_PASSWORD=mot-de-passe-lea
