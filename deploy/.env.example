# Copier en deploy/.env (ignoré par git) et remplacer chaque valeur.
POSTGRES_PASSWORD=change-moi
# Au moins 32 octets : openssl rand -base64 48
JWT_KEY=change-moi-au-moins-32-octets-xxxxxxxxxxxx

# Réseau Docker partagé avec Nginx Proxy Manager.
PROXY_NETWORK=global-network

# Comptes créés au premier démarrage (mot de passe : au moins 12 caractères).
# Inutiles une fois les comptes en base : ils peuvent alors être vidés.
SEED_USER_0_NAME=marie
SEED_USER_0_DISPLAY=Marie
SEED_USER_0_PASSWORD=
SEED_USER_1_NAME=
SEED_USER_1_DISPLAY=
SEED_USER_1_PASSWORD=
SEED_USER_2_NAME=
SEED_USER_2_DISPLAY=
SEED_USER_2_PASSWORD=

# Sauvegarde quotidienne (heure de Paris) et durée de conservation.
BACKUP_TIME=03:00
BACKUP_RETENTION_DAYS=30
